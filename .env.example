# Railway PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/hillside

# Public URL; use the Railway domain first, then the custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4. Leave blank to disable tracking entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Social profiles. Each one only appears in the footer once it is filled in.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_AUTOMATIC_TAX=false

# Shipping amounts are in cents. The public value is inlined at build time so the
# cart drawer can show progress toward free shipping; keep the two in step.
FLAT_SHIPPING_CENTS=895
FREE_SHIPPING_THRESHOLD_CENTS=7500
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=7500

# The shop's timezone, as an IANA name. Class dates are entered and displayed
# against the server clock, so this is the zone customers are shown — and the
# abbreviation printed beside every class time. The app already defaults to
# America/New_York (Eastern), so set this only to move the shop to another zone.
# TZ=America/New_York

# Owner authentication. ADMIN_SESSION_SECRET signs the dashboard cookie and is
# always required. Named admin accounts live in the database — create them with
# `npm run admin:create` — and ADMIN_PASSWORD is the shared fallback password
# that works alongside them with any email address. Leave it unset once every
# admin has their own account.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret

# Optional: an admin account to create on deploy, for a service with no shell
# access. Set all three and the pre-deploy step creates that account if it does
# not already exist. It is safe to leave configured: an address that already has
# an account is left untouched, so a later deploy will not reset a password
# changed since, nor reactivate an account that was revoked.
ADMIN_ACCOUNT_EMAIL=
ADMIN_ACCOUNT_NAME=
ADMIN_ACCOUNT_PASSWORD=

# Secure customer access to online classes. A separate random value is recommended;
# the app falls back to ADMIN_SESSION_SECRET when this is left blank.
CLASS_ACCESS_SECRET=
CLASS_HOST_NAME=Tammy Hill

# Newsletter unsubscribe links live in mailboxes for years, so they should not
# die when the admin session secret is rotated. Set NEWSLETTER_UNSUBSCRIBE_SECRET
# to a dedicated random value. When you rotate it, keep the previous value in
# NEWSLETTER_UNSUBSCRIBE_SECRET_PREVIOUS so older emails still unsubscribe. If
# both are blank, the app falls back to ADMIN_SESSION_SECRET and then
# CLASS_ACCESS_SECRET, and still verifies tokens signed with any of those keys.
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET_PREVIOUS=

# Amazon influencer picks. The associate tag is appended to every pick's link,
# so the dashboard only ever needs the item's address pasted into it. Leave it
# blank and picks still publish — the links simply carry no tracking id, and a
# link pasted with a tag of its own always keeps that one.
AMAZON_ASSOCIATE_TAG=

# Telnyx Video. Keep TELNYX_API_KEY server-side only.
TELNYX_API_KEY=
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
NEXT_PUBLIC_TELNYX_VIDEO_SDK_URL=https://cdn.jsdelivr.net/npm/@telnyx/video@1.0.2/+esm

# Image generation for scripts/generate-image.mjs. Build-time tooling only — the
# running app never reads these, so they belong in the shell or the deploy
# environment's settings rather than in the app's own configuration.
#
# Prefer Gemini: Imagen returns 2K at 4:3, which clears the 1600x1200 brand spec.
# gpt-image-1 tops out at 1536x1024 and needs --allow-upscale.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Only needed to point either provider at a gateway or a compatible host.
# GEMINI_BASE_URL=
# OPENAI_BASE_URL=

# Admin photo uploads. REQUIRED in production: mount a Railway Volume and point
# this at it. Without it the app writes into the container filesystem, which is
# replaced on every deploy — the product rows keep pointing at /media/<id> while
# the files themselves disappear. Production now refuses to start an upload
# rather than write somewhere it will be lost.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=8388608

# How many proxies sit in front of the app and can be trusted to have appended an
# honest X-Forwarded-For entry. Rate limiting identifies callers by counting this
# many hops from the right-hand end of that header, because everything further
# left is supplied by the client and can be forged. Railway's edge is one hop.
TRUSTED_PROXY_HOPS=1

# Business identity and customer email through SendGrid.
# SendGrid is required to email customers their private online-class links.
# The sending domain must be authenticated in SendGrid (Sender Authentication)
# or SendGrid rejects the From address in EMAIL_FROM.
BUSINESS_EMAIL=hello@thehillsidegardens.com
BUSINESS_RETURN_ADDRESS=The Hillside Gardens

# Optional second inbox for owner alerts — a new paid order and an oversold
# order go here as well as to BUSINESS_EMAIL. Meant for Tammy's own everyday
# address, so a sale reaches her wherever she is while the business inbox keeps
# the copy the shop's records are read from. Leave blank to alert only
# BUSINESS_EMAIL. This is a recipient only: mail still goes out as EMAIL_FROM on
# the domain authenticated in SendGrid, because sending as a consumer mailbox
# SendGrid is not authorised for would fail SPF and DKIM and land in spam.
OWNER_PERSONAL_EMAIL=

# Local business details. Filling these in upgrades the site's structured data
# from a generic Store to a LocalBusiness, which is what local search results and
# the Google business panel read. Leave blank until they are real.
BUSINESS_STREET_ADDRESS=
BUSINESS_CITY=
BUSINESS_STATE=
BUSINESS_POSTAL_CODE=
BUSINESS_PHONE=
# Optional override for Stripe Tax on pickup checkouts. When blank, the app uses
# BUSINESS_POSTAL_CODE, then the public Ebensburg ZIP. This is a tax locality,
# not a street address to print on the site.
# PICKUP_POSTAL_CODE=
# Pipe separated, schema.org format, e.g. "Mo-Fr 09:00-17:00|Sa 10:00-14:00"
BUSINESS_OPENING_HOURS=
SENDGRID_API_KEY=
EMAIL_FROM=The Hillside Gardens <orders@thehillsidegardens.com>
