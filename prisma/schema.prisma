generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * The original, deliberately broad shelf a product sits on. Superseded for
 * merchandising by `Category`, which the owner edits, but kept because every
 * product row, the return-policy markup and the shop's legacy category links
 * still read it. A product's `type` is derived from its category's
 * `legacyType` on save, so the two can never disagree.
 */
enum ProductType {
  PLANT
  TEA
  TEA_SUPPLY
  LOTION
  SOAP
  OTHER
}

/**
 * Which set of structured detail fields a product is asked for. A tea needs a
 * steep time and a caffeine status; a flytrap needs a dormancy note and a water
 * type; a bag of terrarium gravel needs neither. Carried on the category rather
 * than on the product so Tammy picks one thing — "Carnivorous Plants" — and the
 * right questions appear.
 */
enum ProductSpecKind {
  PLANT
  CARNIVOROUS_PLANT
  TEA
  SOAP
  LOTION
  HARD_GOOD
  GENERAL
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentMethod {
  SHIP
  PICKUP
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  SENT
  FAILED
}

/**
 * What an outbound email was for. Kept as an enum rather than free text so the
 * owner's sent-mail page can filter on it without matching subject lines, which
 * change whenever the copy is edited.
 */
enum EmailKind {
  ORDER_CONFIRMATION
  ORDER_ADMIN
  PICKUP_READY
  SHIPPING_UPDATE
  CLASS_CONFIRMATION
  CLASS_ADMIN
  STOCK_ALERT
  NEWSLETTER
  CART_RECOVERY
  CONTACT
  REVIEW
  REPLY
  GIFT_CARD
  MANUAL
  OTHER
}

enum CareGuideType {
  PLANT
  GENERAL
  PROBLEM
  SEASONAL
  BEGINNER
}

/**
 * Why one product is worth showing beside another. The kind is the *section* a
 * recommendation appears in, not a loose label: "Pairs well with" is a companion
 * (a tea and the infuser you brew it in), "Complete the setup" is something the
 * first product needs in order to work (a carnivorous plant and its growing
 * medium), and "You may also like" is an alternative to it rather than an
 * addition to it.
 *
 * Keeping them apart is the whole point of the feature — a shop that files every
 * relationship under one heading is back to showing whatever shares a category.
 */
enum ProductRelationKind {
  PAIRS_WITH
  COMPLETES_SETUP
  SIMILAR
}

/**
 * How a merchandising label is decided. `AUTO` lets the shop work it out from
 * order history or a listing date; the other two are Tammy overruling it, which
 * she needs for the cases the data cannot see — a piece she knows is about to be
 * everywhere, or one that sold well once and is not coming back.
 */
enum MerchandisingMode {
  AUTO
  ALWAYS
  NEVER
}

/**
 * What a homepage row is a row *of*. The homepage used to hardcode one featured
 * grid and one collection strip, so changing what the front page led with meant
 * changing the code.
 */
enum HomepageSectionKind {
  FEATURED
  NEW_ARRIVALS
  BEST_SELLERS
  RECENT_BEST_SELLERS
  STAFF_PICKS
  SEASONAL
  ON_SALE
  COLLECTION
  COLLECTION_TILES
  BUNDLES
}

/**
 * How a product is being kept in stock, as the owner declares it. Deliberately
 * separate from the counts: "none on the bench" is arithmetic, but *why* there
 * are none — reordered, made when ordered, done for the season, retired — is
 * something only Tammy knows, and it decides whether an empty shelf belongs on
 * the reorder list at all.
 */
enum InventoryStatus {
  STOCKED
  ON_ORDER
  MADE_TO_ORDER
  SEASONAL
  DISCONTINUED
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  sku              String?           @unique
  shortDescription String?
  description      String
  details          String?
  careNotes        String?
  shippingNote     String?
  ships            Boolean      @default(true)
  pickup           Boolean      @default(true)
  /**
   * The broad legacy shelf. Derived from `category.legacyType` whenever a
   * category is chosen, and left as the owner set it on the handful of rows
   * that predate categories entirely.
   */
  type             ProductType
  /**
   * The merchandising category this product primarily belongs to — one
   * structured answer to "what is it", against which the shop filters and from
   * which the detail fields below are chosen. Optional so no existing row had
   * to be rewritten to add the column; the seed backfills every one of them.
   */
  categoryId       String?
  priceCents       Int
  compareAtCents   Int?
  inventory        Int               @default(0)
  imageUrl         String?
  badge            String?
  /**
   * The variants a product is sold in — sizes, pot styles, jar volumes — stored
   * as `[{ label, priceCents?, inventory?, sku?, imageUrl?, weightOunces?,
   * dimensions?, ships?, pickup? }]`. Everything after `label` is optional and
   * absent means "the same as the product": a variant carries a price only when
   * it differs from `priceCents`, so raising the base price still moves every
   * variant with it, and carries an `inventory` only when the owner counts the
   * variants separately. Once any variant does, `inventory` above is kept equal
   * to the sum of them, so every "is this sellable" query can go on reading the
   * column alone.
   *
   * The column keeps its original name because live rows and in-flight checkout
   * sessions hold data under it; only the shape has grown, and it grew in a way
   * every older row already validates against.
   */
  sizes            Json?
  /**
   * What the variant dropdown is called on the product page — "Pot size",
   * "Jar size".
   */
  sizeLabel        String?
  /**
   * Which gift guides the owner has deliberately put this product in, as guide
   * slugs from `lib/gifts.ts` ("tea-lover", "teacher"). Guides also match on
   * type, price and keywords, so an untagged product still lands somewhere
   * sensible; a tag only ever adds a guide.
   *
   * `GIFT_EXCLUDE_TAG` ("none") is reserved and means the opposite: keep this
   * product out of every guide, however well it matches. That is the one way
   * to say "this is not a gift" about something the derived rules would
   * otherwise pick up.
   */
  giftTags         String[]     @default([])
  /**
   * Structured, category-specific detail, stored as `{ fieldKey: value }` and
   * read through `lib/product-specs.ts`. A plant's light and water needs, a
   * tea's steep time and allergens, a soap's full ingredient list. Kept as JSON
   * rather than forty mostly-null columns because which fields apply is decided
   * by the category, and the registry that decides it also renders both the
   * admin form and the public specification table.
   */
  specs            Json?
  /** Shipping weight of the product as sold one way, in ounces. */
  weightOunces     Int?
  /** Packed or finished dimensions, as the owner writes them: `8 × 8 × 10 in`. */
  dimensions       String?
  active           Boolean      @default(true)
  featured         Boolean      @default(false)
  /**
   * Tammy's own pick, kept separate from `featured` because they answer
   * different questions: featured is "put this in front of people", a staff pick
   * is "this is the one I'd take home". Both can be true, and the shop labels
   * them differently.
   */
  staffPick        Boolean           @default(false)
  /**
   * Where the product sits within a hand-ordered shelf. Lower comes first, and
   * the merchandising page writes these from a drag-and-drop list rather than
   * asking anyone to type numbers.
   */
  sortOrder        Int               @default(0)
  /**
   * The Latin name, when a plant has one people search by. `Epipremnum aureum`
   * is how half the pothos questions arrive, and matching it only in the body
   * copy meant a shopper who typed it got whichever product happened to mention
   * it in passing.
   */
  botanical        String?
  /**
   * Extra words this product should be findable by — common misspellings, the
   * name it is sold under elsewhere, a nickname. Never rendered to shoppers, so
   * it is a search field rather than a place to repeat the description.
   */
  searchTerms      String?
  /**
   * Filterable attributes ("pet-safe", "low-light", "handmade"), stored as the
   * slugs defined in `lib/product-tags.ts`. An array rather than a join table:
   * the whole catalog is a few hundred rows, the vocabulary is fixed, and the
   * shop filters in the browser from one already-loaded list.
   */
  tags             String[]          @default([])
  /**
   * Free-text recommendation traits — `terrarium`, `carnivorous`, `planter`,
   * `substrate`, `infuser` — matched only against other products.
   *
   * Deliberately not `tags`. That field is the closed, shopper-facing filter
   * vocabulary and `normalizeTags` keeps only slugs it recognises, so a trait
   * written there is erased the next time the product is saved from the product
   * form. The two also want opposite things: `tags` is a fixed list a shopper
   * picks from, traits are open words nobody browses by.
   */
  traits           String[]          @default([])
  /**
   * Whether the best-seller badge is earned from paid orders (`AUTO`) or set by
   * hand. See `lib/merchandising.ts` for the thresholds `AUTO` applies.
   */
  bestSellerMode   MerchandisingMode @default(AUTO)
  /**
   * Same idea for "new": listed recently, or pinned/suppressed by Tammy.
   */
  newArrivalMode   MerchandisingMode @default(AUTO)
  /**
   * When a seasonal piece is in season. Deliberately *only* merchandising: a
   * product outside its window keeps its page, its price and its listing, it
   * simply stops being pulled into seasonal rows and loses the seasonal badge.
   * Hiding stock automatically on a date is how a shop ends up with an
   * unexplained empty shelf nobody remembers scheduling.
   */
  seasonStartsAt   DateTime?
  seasonEndsAt     DateTime?
  galleryImages    String[]     @default([])

  /**
   * The named photographs a product page wants beside the main one. Kept as
   * their own columns rather than as more entries in `galleryImages`, because
   * each answers a different question a shopper actually asks — what does it
   * look like in a room, what does the leaf detail look like, how big is it,
   * what turns up in the box — and the customer gallery labels them by name.
   * `galleryImages` stays what it was: extra angles with nothing particular to
   * say.
   */
  lifestyleImageUrl String?
  detailImageUrl    String?
  scaleImageUrl     String?
  packagingImageUrl String?

  /**
   * Restocking, as a shopkeeper thinks about it. Deliberately no cost, margin
   * or valuation column anywhere here: this is the list Tammy works from at the
   * potting bench, not a set of books.
   *
   * `reorderPoint` is measured against the product total rather than against a
   * single size, because a reorder is placed for the product — one order of
   * plugs, one case of jars — while `reorderQuantity` is how many of them to
   * ask for. Both are optional: a plant she divides herself has neither.
   */
  supplier           String?
  supplierItemNumber String?
  reorderPoint       Int?
  reorderQuantity    Int?
  inventoryNotes     String?
  lastRestockedAt    DateTime?
  inventoryStatus    InventoryStatus @default(STOCKED)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            OrderItem[]
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections      Collection[] @relation("ProductCollections")
  reviews          Review[]
  stockAlerts      StockAlert[]
  careSheets       CareSheet[]
  careGuides       CareGuideProduct[]
  bundleItems      BundleItem[]
  orderComponents  OrderItemComponent[]
  recommends       ProductRelation[]    @relation("RecommendationFrom")
  recommendedBy    ProductRelation[]    @relation("RecommendationTo")
}

/**
 * One owner-configured recommendation: "show this tea infuser under Pairs well
 * with on the Hillside Calm Tea page".
 *
 * Directional on purpose. A planter belongs under "Complete the setup" on a
 * plant, but a plant is not what completes a planter — reading one row both ways
 * would put the wrong thing under the wrong heading, which is the
 * category-shaped noise this exists to replace.
 */
model ProductRelation {
  id               String              @id @default(cuid())
  productId        String
  relatedProductId String
  kind             ProductRelationKind @default(PAIRS_WITH)
  /** Tammy's own words for why, printed under the card. */
  note             String?
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  product          Product             @relation("RecommendationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related          Product             @relation("RecommendationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, kind])
  @@index([relatedProductId])
}

/**
 * A product featured on a care guide, with the owner's reason for it.
 *
 * `CareSheet.productId` already names the one plant a profile is *about*; this
 * is everything else — the sphagnum a terrarium guide calls for, the distilled
 * water a carnivorous guide insists on. Its own table because a guide can
 * feature several, and because the note is what keeps the block reading as
 * editorial rather than as an advertisement bolted onto the article.
 */
model CareGuideProduct {
  id          String    @id @default(cuid())
  careSheetId String
  productId   String
  /** "This is what we pot ours in" — the line printed beside the product. */
  note        String?
  sortOrder   Int       @default(0)
  careSheet   CareSheet @relation(fields: [careSheetId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([careSheetId, productId])
  @@index([productId])
}

/**
 * A set sold as one thing — the Tea Starter Set, the Terrarium Starter Kit.
 *
 * A bundle has a price, a photograph and a description of its own but **no
 * inventory column**, and that absence is the design. What is on the bench is
 * the components; a second count here would be a copy that drifts the first time
 * a loose infuser is sold, and the shop would go on offering a set it cannot
 * build. How many sets are available is therefore always derived — the fewest
 * any required component can supply — so a bundle whose component runs out goes
 * unavailable on its own, with nothing for anyone to remember to switch off.
 */
model Bundle {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  tagline       String?
  description   String
  imageUrl      String?
  galleryImages String[]     @default([])
  /** What the set sells for. Independent of what its parts add up to. */
  priceCents    Int
  badge         String?
  active        Boolean      @default(true)
  featured      Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         BundleItem[]
  orderItems    OrderItem[]
}

/**
 * One line of a bundle's recipe: which product, in which variant, how many.
 *
 * `size` pins the variant when the set calls for one — the Tea Starter Set wants
 * the 2 oz tin, not whichever tin a shopper would otherwise have chosen — and is
 * null when any variant will do, or when the product is sold one way. A product
 * counted per size is checked and decremented against exactly that size.
 *
 * `optional` marks a garnish that should not take the whole set off sale: the
 * dried botanical in a gift box is worth listing, but running out of it is no
 * reason to stop selling the tea, soap and lotion beside it.
 */
model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  size      String?
  quantity  Int     @default(1)
  optional  Boolean @default(false)
  note      String?
  sortOrder Int     @default(0)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
}

/**
 * The merchandising taxonomy: "Houseplants", "Carnivorous Plants", "Tea
 * Accessories". One category per product, owner-editable, and distinct from a
 * `Collection` on purpose — a category answers *what a thing is* and a product
 * has exactly one, while a collection answers *why you might want it* ("Pet
 * Friendly", "Gifts Under $30") and a product may sit in as many as apply.
 */
model Category {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  tagline     String?
  description String?
  imageUrl    String?
  /** Which structured detail fields products in this category are asked for. */
  specKind    ProductSpecKind @default(GENERAL)
  /**
   * The legacy `ProductType` a product in this category is recorded as. Return
   * policies, the shop's older category links and every existing order read
   * that enum, so each category has to say which one it stands in for.
   */
  legacyType  ProductType     @default(OTHER)
  active      Boolean         @default(true)
  /** Whether the category is offered as a filter chip and a shop-by tile. */
  featured    Boolean         @default(true)
  sortOrder   Int             @default(0)
  /**
   * The editorial half of a category page, mirroring `Collection`.
   *
   * A category is the structural parent — houseplants, carnivorous plants,
   * terrarium supplies — so it is what people search for and what a stranger
   * lands on. Without these it had no page of its own: it was reachable only as
   * `/shop?category=`, a filtered grid sharing the shop's canonical, with
   * nothing on it but products. Both models carry these because both are
   * browsable groupings that deserve a page; the rendering is shared rather
   * than duplicated, in `components/GroupingLanding.tsx`.
   */
  intro           String?
  body            String?
  /** `[{ question, answer }]`, the only source of this page's FAQPage markup. */
  faq             Json?
  metaTitle       String?
  metaDescription String?
  keywords        String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    Product[]
  promotions  Promotion[]
  /** The care guides worth reading beside this category. */
  careSheets  CareSheet[]     @relation("CategoryCareGuides")

}

model Order {
  id                      String            @id @default(cuid())
  invoiceNumber           String            @unique
  stripeSessionId         String?           @unique
  paymentIntentId         String?           @unique
  stripeInvoiceId         String?
  status                  OrderStatus       @default(PENDING)
  customerName            String
  email                   String
  phone                   String?
  address1                String
  address2                String?
  city                    String
  state                   String
  postalCode              String
  country                 String            @default("US")
  subtotalCents           Int
  shippingCents           Int               @default(0)
  taxCents                Int               @default(0)
  discountCents           Int               @default(0)
  totalCents              Int
  refundedCents           Int               @default(0)
  // Set once when a full refund returns stock, so repeated deliveries of the same
  // Stripe event cannot inflate inventory.
  inventoryRestoredAt     DateTime?
  shippingMethod          String?
  fulfillmentMethod       FulfillmentMethod @default(SHIP)
  giftMessage             String?
  pickupNote              String?
  trackingCarrier         String?
  trackingNumber          String?
  internalNotes           String?
  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?
  /**
   * When the "how did it settle in?" review invitation went out. Set once, and
   * checked before every send, so an order can only ever be asked once however
   * many times the follow-up runs.
   */
  reviewRequestSentAt     DateTime?
  fulfilledAt             DateTime?
  /**
   * The promo code this order was placed with, and what it took off. The code
   * is snapshotted beside the id because a promotion the owner later renames,
   * re-rates or deletes must not rewrite what this customer was charged under.
   */
  promotionId             String?
  promoCode               String?
  promoDiscountCents      Int               @default(0)
  /**
   * The gift card spent against this order, and how much of it. Moved aside on
   * the card when the checkout session is created and only taken when the order
   * is paid, so an abandoned basket gives the money back.
   */
  giftCardId              String?
  giftCardCode            String?
  giftCardCents           Int               @default(0)
  /**
   * When the promo redemption was recorded and the gift-card hold was taken for
   * good. Set once, and the guard that makes a redelivered Stripe event a no-op
   * rather than a second helping of somebody's gift card.
   */
  discountsSettledAt      DateTime?
  /**
   * When a hold that never settled was handed back — an abandoned checkout, an
   * expired session. Cleared again if that order settles after all, which Stripe
   * can deliver in that order, and which is why settlement has to know whether
   * it is taking a hold or re-taking money already given back.
   */
  discountsReleasedAt     DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  items                   OrderItem[]
  promotion               Promotion?        @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  giftCard                GiftCard?         @relation(fields: [giftCardId], references: [id], onDelete: SetNull)

  @@index([promotionId])
  @@index([giftCardId])
}

/**
 * A line on an order: either one product, or one bundle. Exactly one of
 * `productId` and `bundleId` is set.
 *
 * A bundle line carries the price the customer actually paid for the set and the
 * set's own name, so the receipt, the packing slip and the order total all read
 * the way the shopper bought it — and the physical goods it takes off the shelf
 * are its `components`. Recording a bundle as several ordinary product lines
 * instead would have meant inventing a per-product share of the set price, and
 * three succulents sold together at $35 have no whole-cent share to invent.
 */
model OrderItem {
  id         String               @id @default(cuid())
  orderId    String
  productId  String?
  bundleId   String?
  name       String
  /**
   * The size the customer chose, when the product is sold in more than one.
   */
  size       String?
  quantity   Int
  unitCents  Int
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?             @relation(fields: [productId], references: [id])
  /**
   * Null once the bundle is deleted. The line keeps its name, its price and its
   * components regardless, because an order records what was sold and must not
   * change when the shop stops selling it.
   */
  bundle     Bundle?              @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  components OrderItemComponent[]

  @@index([bundleId])
}

/**
 * What a bundle line actually took off the shelf, frozen at the moment of sale.
 *
 * A snapshot rather than a lookup back through `BundleItem`, because a refund six
 * weeks later has to return what was sold, not what the recipe says today.
 * `quantity` is the total for the line — the recipe's quantity already multiplied
 * by how many sets were bought — so every stock movement reads it straight.
 */
model OrderItemComponent {
  id          String    @id @default(cuid())
  orderItemId String
  productId   String
  /** The product's name as it was sold, for the packing slip. */
  name        String
  size        String?
  quantity    Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([orderItemId])
  @@index([productId])
}

model CareSheet {
  id          String        @id @default(cuid())
  plantName   String
  slug        String        @unique
  guideType   CareGuideType @default(PLANT)
  category    String?
  difficulty  String?
  botanical   String?
  summary     String
  light       String        @default("")
  water       String        @default("")
  humidity    String        @default("")
  soil        String        @default("")
  feeding     String        @default("")
  temperature String        @default("")
  petSafety   String?
  tips        String
  symptoms    String?
  causes      String?
  treatment   String?
  prevention  String?
  checklist   String?
  imageUrl    String?
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  published   Boolean       @default(true)
  productId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  collections Collection[]  @relation("CollectionCareGuides")
  categories  Category[]    @relation("CategoryCareGuides")
  /** Anything else the guide recommends, beyond the plant it is about. */
  products    CareGuideProduct[]

  @@index([productId])
}

model ClassEvent {
  id                     String              @id @default(cuid())
  slug                   String?             @unique
  title                  String
  description            String
  startsAt               DateTime
  location               String
  format                 ClassFormat         @default(IN_PERSON)
  priceCents             Int
  capacity               Int
  durationMinutes        Int                 @default(90)
  whatToBring            String?
  registrationDeadline   DateTime?
  imageUrl               String?
  active                 Boolean             @default(true)
  onlineInstructions     String?
  telnyxRoomId           String?             @unique
  telnyxRecordingEnabled Boolean             @default(false)
  joinOpensMinutesBefore Int                 @default(30)
  joinClosesMinutesAfter Int                 @default(60)
  registrations          ClassRegistration[]
}

model ClassRegistration {
  id                      String             @id @default(cuid())
  classEventId            String
  stripeSessionId         String             @unique
  paymentIntentId         String?            @unique
  name                    String
  email                   String
  phone                   String?
  seats                   Int                @default(1)
  amountCents             Int
  status                  RegistrationStatus @default(PENDING)
  joinTokenHash           String?            @unique
  holdExpiresAt           DateTime?
  confirmationEmailSentAt DateTime?
  lastJoinedAt            DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  classEvent              ClassEvent         @relation(fields: [classEventId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  caption   String?
  linkUrl   String?
  linkLabel String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model AmazonPick {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  amazonUrl   String
  category    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  /**
   * Which signup form this address came from, as one of the keys in
   * `lib/newsletter-source.ts`. Anything the browser posts that is not on that
   * list is stored as "website", so the column stays a small set Tammy can
   * count rather than free text.
   */
  source         String?   @default("website")
  /**
   * The page the form was on, when knowing it helps — the product or care guide
   * slug behind a "product" or "care-guide" signup. A site path or nothing.
   */
  sourceDetail   String?
  active         Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  replies   EmailLog[]
}

/**
 * Every outbound email the app attempts, kept so the owner can answer "did she
 * ever get her receipt?" from the dashboard instead of from SendGrid's console.
 * Failures are rows too, and that is the point of the table: a confirmation
 * that never left was previously visible only as a line in the server log.
 */
model EmailLog {
  id               String          @id @default(cuid())
  /**
   * Every recipient the send was addressed to. A list because the owner's new
   * order notice goes to the business inbox and her personal one together.
   */
  to               String[]        @default([])
  subject          String
  /**
   * The exact body that was sent, so the page can show what she actually wrote.
   */
  html             String
  /**
   * The recipients and the message as plain text, built once when the row is
   * written so the sent-mail page can search in SQL and page through the result
   * properly. Searching the stored HTML in memory meant reading a fixed window
   * of recent rows — anything older than that window was unfindable, in a table
   * whose whole purpose is answering "did she ever get her receipt?".
   * Owner-authored mail contributes only what Tammy typed, not the greeting,
   * signature and quoted message around it, or a search for "Hillside" would
   * match every email the shop has ever sent through its own sign-off.
   */
  searchText       String          @default("")
  kind             EmailKind       @default(OTHER)
  status           EmailStatus
  /**
   * Why a failed send failed: not-configured, provider-error, network-error.
   */
  reason           String?
  /**
   * SendGrid's x-message-id, for tracing a delivery in their dashboard.
   */
  providerId       String?
  /**
   * Set when this email is the owner's reply to a customer message, which is
   * what threads the reply under the message on the email page.
   */
  contactMessageId String?
  createdAt        DateTime        @default(now())
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([contactMessageId])
}

/**
 * A collection is the shop's category landing page, not just a filter. Everything
 * below `description` exists so a page about houseplants can read like a page
 * about houseplants — an introduction, the care guides that belong with it, the
 * questions people actually ask — instead of a heading over a product grid that
 * is empty half the year.
 */
model Collection {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  tagline         String?
  description     String?
  imageUrl        String?
  featured        Boolean           @default(true)
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  /**
   * The short, human introduction above the products. Plain paragraphs.
   */
  intro           String?
  /**
   * Longer editorial copy below the grid — how to choose one, what to expect
   * locally, what pairs with it. Blank lines separate paragraphs; a line ending
   * in a colon is rendered as a subheading.
   */
  body            String?
  /**
   * Category questions and answers, stored as `[{ question, answer }]`. These
   * render as the page's FAQ and are the only thing that emits FAQPage markup
   * for the category, so a category with none simply publishes no FAQ schema.
   */
  faq             Json?
  /**
   * Overrides for the page title and meta description, when the title is not enough.
   */
  metaTitle       String?
  metaDescription String?
  /**
   * Extra words this category should be findable by ("carnivorous", "venus
   * flytrap", "terrarium"). Search reads them; the page never prints them.
   */
  keywords        String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  products        Product[]         @relation("ProductCollections")
  /**
   * The care guides worth reading beside this category.
   */
  careSheets      CareSheet[]       @relation("CollectionCareGuides")
  sections        HomepageSection[]
}

/**
 * One row on the homepage, in the order Tammy arranged them. What a row holds is
 * decided by `kind`; `COLLECTION` rows point at one collection, and the rest pull
 * from the merchandising rules in `lib/merchandising.ts`. A row whose query comes
 * back empty renders nothing at all rather than an empty heading.
 */
model HomepageSection {
  id           String              @id @default(cuid())
  kind         HomepageSectionKind
  eyebrow      String?
  title        String
  subtitle     String?
  /**
   * How many products (or tiles) the row shows.
   */
  maxItems     Int                 @default(4)
  collectionId String?
  active       Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  collection   Collection?         @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  authorName       String
  email            String?
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  ownerReply       String?
  /**
   * How many shoppers said this review helped them. The only ordering signal a
   * shop this size can honestly offer — there is no purchase history behind a
   * "most helpful" sort otherwise — and it is why that sort exists at all.
   */
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

model CartLead {
  id            String    @id @default(cuid())
  email         String    @unique
  itemsJson     String?
  subtotalCents Int       @default(0)
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/**
 * A record that a one-time seed has already run.
 * Seeds that write starting content used to decide "has this run?" by looking at
 * whether the content was empty — which cannot tell an untouched install from an
 * owner who deliberately cleared it. Emptiness is valid editor output: Tammy
 * clearing a category's introduction, or deleting every homepage row, is a
 * choice, and re-running the deploy seed put all of it back. A row here says the
 * seed has had its turn, so it never takes another.
 */
model SeedMarker {
  /**
   * e.g. `homepage-sections`, or `category-content:carnivorous-plants`.
   */
  key       String   @id
  createdAt DateTime @default(now())
}

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  active            Boolean   @default(true)
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/**
 * How a promotion code takes money off a basket.
 *
 * `FREE_SHIPPING` is its own kind rather than a hundred-percent coupon on the
 * shipping line, because shipping is not a line item here: it is a Stripe
 * shipping rate chosen as the session is created, so the only way to give it
 * away is to choose the free one instead.
 */
enum DiscountKind {
  PERCENT
  AMOUNT
  FREE_SHIPPING
}

/**
 * What one row of a gift card's ledger records. `HOLD` and `RELEASE` move money
 * between the spendable balance and the reserved one while a checkout is open;
 * only `REDEEM` takes it off the card.
 */
enum GiftCardEntryKind {
  ISSUE
  HOLD
  RELEASE
  REDEEM
  REFUND
  ADJUST
}

/**
 * A promo code the owner hands out — SPRING20, or one of fifty printed for a
 * market stall. The discount is worked out here rather than in Stripe's coupon
 * dashboard so the rules Tammy sets (a minimum basket, one category, a date
 * window, a redemption cap) are enforced against the real cart before Stripe is
 * asked for a session, and so the shop's own records can say what was given
 * away and on which order.
 */
model Promotion {
  id               String                @id @default(cuid())
  /** Normalized to upper case on save, so the customer may type it either way. */
  code             String                @unique
  /** What this code is for, in Tammy's words. Never shown to a customer. */
  label            String?
  kind             DiscountKind          @default(PERCENT)
  /** 1–100, on a PERCENT promotion. */
  percentOff       Int?
  /** A flat amount off, on an AMOUNT promotion. */
  amountOffCents   Int?
  /** The basket has to reach this before the code is accepted at all. */
  minSubtotalCents Int                   @default(0)
  /**
   * Narrows the discount to one category: "20% off teas" takes nothing off the
   * pot in the same basket. Null discounts everything.
   */
  categoryId       String?
  startsAt         DateTime?
  endsAt           DateTime?
  /** How many times the code may be claimed altogether. Null is unlimited. */
  maxRedemptions   Int?
  /**
   * How many claims are spoken for: the settled redemptions *and* the holds
   * sitting on checkouts that are still open. Raised when a checkout session is
   * created and lowered again if that hold is released, which is what stops a
   * one-use code being spent twice inside the thirty-five minutes before the
   * first of the two settles. The settled count is the number of redemption
   * rows, so the difference between the two is what is currently held.
   */
  redemptionsUsed  Int                   @default(0)
  active           Boolean               @default(true)
  /** Which generated run this code came from, when it came from one. */
  batch            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  redemptions      PromotionRedemption[]
  orders           Order[]

  @@index([categoryId])
}

/** One settled use of a promo code, written when the order is paid. */
model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  /** One row per order, which is what makes a redelivered webhook a no-op. */
  orderId     String    @unique
  /** The code as it read at the time, so a rename cannot rewrite history. */
  code        String
  email       String?
  amountCents Int
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

/**
 * A gift card with money on it. Unlike a promotion this is a balance rather
 * than a rule: it is spent down over as many orders as it takes, and whatever
 * is left stays on the card.
 *
 * `balanceCents` is what the card can spend right now. `reservedCents` is money
 * a checkout that is open but unpaid has moved aside: still on the card, not
 * spendable, and given back in full if that checkout is abandoned. The money
 * left on a card altogether is the two added together, and only `REDEEM` —
 * which fires when the order is paid — takes any of it away for good.
 *
 * Moving the two together in one conditional update is what makes this safe
 * under load: "has this card still got twenty dollars" stays a comparison
 * against a single column, which Postgres settles under the row lock, so two
 * checkouts opened in the same second cannot both spend the last of a card.
 */
model GiftCard {
  id             String          @id @default(cuid())
  /** Stored and compared in the grouped upper-case form the card is printed in. */
  code           String          @unique
  initialCents   Int
  /** Spendable now. A hold moves money out of here into `reservedCents`. */
  balanceCents   Int
  /** Held by an open checkout: still on the card, not spendable, not yet spent. */
  reservedCents  Int             @default(0)
  recipientName  String?
  recipientEmail String?
  purchaserName  String?
  purchaserEmail String?
  /** A note from the giver, included in the email to the recipient. */
  message        String?
  expiresAt      DateTime?
  active         Boolean         @default(true)
  /** Which generated run this card came from, when it came from one. */
  batch          String?
  /** Tammy's own note. Never shown to the customer. */
  note           String?
  /** Which admin issued it, for the ledger. */
  issuedBy       String?
  /** When the card was last emailed to its recipient. */
  lastSentAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        GiftCardEntry[]
  orders         Order[]
}

/**
 * Every movement on a gift card, so "where did the other twelve dollars go?"
 * has an answer that is not a guess.
 *
 * Rows are immutable and keyed by `reference` — `hold:<orderId>`,
 * `redeem:<orderId>` — which is what makes a retried Stripe webhook, or a
 * release that runs twice, land exactly once.
 */
model GiftCardEntry {
  id                 String            @id @default(cuid())
  giftCardId         String
  kind               GiftCardEntryKind
  /** Signed change to `GiftCard.balanceCents`, the spendable figure. */
  amountCents        Int               @default(0)
  /** Signed change to `GiftCard.reservedCents`. */
  reservedDeltaCents Int               @default(0)
  balanceAfterCents  Int
  reservedAfterCents Int
  orderId            String?
  /** Idempotency key: one row per event, however often it is delivered. */
  reference          String            @unique
  note               String?
  createdAt          DateTime          @default(now())
  giftCard           GiftCard          @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt])
}
