generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  PLANT
  TEA
  TEA_SUPPLY
  LOTION
  SOAP
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentMethod {
  SHIP
  PICKUP
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CareGuideType {
  PLANT
  GENERAL
  PROBLEM
  SEASONAL
}

model Product {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  sku              String?      @unique
  shortDescription String?
  description      String
  details          String?
  careNotes        String?
  shippingNote     String?
  ships            Boolean      @default(true)
  pickup           Boolean      @default(true)
  type             ProductType
  priceCents       Int
  compareAtCents   Int?
  inventory        Int          @default(0)
  imageUrl         String?
  badge            String?
  active           Boolean      @default(true)
  featured         Boolean      @default(false)
  sortOrder        Int          @default(0)
  galleryImages    String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            OrderItem[]
  collections      Collection[] @relation("ProductCollections")
  reviews          Review[]
  stockAlerts      StockAlert[]
  careSheets       CareSheet[]
}

model Order {
  id                      String      @id @default(cuid())
  invoiceNumber           String      @unique
  stripeSessionId         String?     @unique
  paymentIntentId         String?     @unique
  stripeInvoiceId         String?
  status                  OrderStatus @default(PENDING)
  customerName            String
  email                   String
  phone                   String?
  address1                String
  address2                String?
  city                    String
  state                   String
  postalCode              String
  country                 String      @default("US")
  subtotalCents           Int
  shippingCents           Int         @default(0)
  taxCents                Int         @default(0)
  discountCents           Int         @default(0)
  totalCents              Int
  refundedCents           Int         @default(0)
  // Set once when a full refund returns stock, so repeated deliveries of the same
  // Stripe event cannot inflate inventory.
  inventoryRestoredAt     DateTime?
  shippingMethod          String?
  fulfillmentMethod       FulfillmentMethod @default(SHIP)
  giftMessage             String?
  pickupNote              String?
  trackingCarrier         String?
  trackingNumber          String?
  internalNotes           String?
  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?
  fulfilledAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  items                   OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  quantity  Int
  unitCents Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model CareSheet {
  id          String        @id @default(cuid())
  plantName   String
  slug        String        @unique
  guideType   CareGuideType @default(PLANT)
  category    String?
  difficulty  String?
  botanical   String?
  summary     String
  light       String        @default("")
  water       String        @default("")
  humidity    String        @default("")
  soil        String        @default("")
  feeding     String        @default("")
  temperature String        @default("")
  petSafety   String?
  tips        String
  symptoms    String?
  causes      String?
  treatment   String?
  prevention  String?
  checklist   String?
  imageUrl    String?
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  published   Boolean       @default(true)
  productId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ClassEvent {
  id                     String              @id @default(cuid())
  slug                   String?             @unique
  title                  String
  description            String
  startsAt               DateTime
  location               String
  format                 ClassFormat         @default(IN_PERSON)
  priceCents             Int
  capacity               Int
  durationMinutes        Int                 @default(90)
  whatToBring            String?
  registrationDeadline   DateTime?
  imageUrl               String?
  active                 Boolean             @default(true)
  onlineInstructions     String?
  telnyxRoomId           String?             @unique
  telnyxRecordingEnabled Boolean             @default(false)
  joinOpensMinutesBefore Int                 @default(30)
  joinClosesMinutesAfter Int                 @default(60)
  registrations          ClassRegistration[]
}

model ClassRegistration {
  id                      String             @id @default(cuid())
  classEventId            String
  stripeSessionId         String             @unique
  paymentIntentId         String?            @unique
  name                    String
  email                   String
  phone                   String?
  seats                   Int                @default(1)
  amountCents             Int
  status                  RegistrationStatus @default(PENDING)
  joinTokenHash           String?            @unique
  holdExpiresAt           DateTime?
  confirmationEmailSentAt DateTime?
  lastJoinedAt            DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  classEvent              ClassEvent         @relation(fields: [classEventId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  caption   String?
  linkUrl   String?
  linkLabel String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model AmazonPick {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  amazonUrl   String
  category    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String?   @default("website")
  active         Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  tagline     String?
  description String?
  imageUrl    String?
  featured    Boolean   @default(true)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("ProductCollections")
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  authorName       String
  email            String?
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  ownerReply       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

model CartLead {
  id            String    @id @default(cuid())
  email         String    @unique
  itemsJson     String?
  subtotalCents Int       @default(0)
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  active            Boolean   @default(true)
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
