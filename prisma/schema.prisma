generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  PLANT
  TEA
  TEA_SUPPLY
  LOTION
  SOAP
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentMethod {
  SHIP
  PICKUP
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  SENT
  FAILED
}

/**
 * What an outbound email was for. Kept as an enum rather than free text so the
 * owner's sent-mail page can filter on it without matching subject lines, which
 * change whenever the copy is edited.
 */
enum EmailKind {
  ORDER_CONFIRMATION
  ORDER_ADMIN
  PICKUP_READY
  SHIPPING_UPDATE
  CLASS_CONFIRMATION
  CLASS_ADMIN
  STOCK_ALERT
  NEWSLETTER
  CART_RECOVERY
  CONTACT
  REVIEW
  REPLY
  MANUAL
  OTHER
}

enum CareGuideType {
  PLANT
  GENERAL
  PROBLEM
  SEASONAL
}

model Product {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  sku              String?      @unique
  shortDescription String?
  description      String
  details          String?
  careNotes        String?
  shippingNote     String?
  ships            Boolean      @default(true)
  pickup           Boolean      @default(true)
  type             ProductType
  priceCents       Int
  compareAtCents   Int?
  inventory        Int          @default(0)
  imageUrl         String?
  badge            String?
  /**
   * Optional size choices for a product sold in more than one size, stored as
   * `[{ label, priceCents?, inventory? }]`. An option carries a price only when
   * it differs from `priceCents`, so raising the base price still moves every
   * size with it, and carries an `inventory` only when the owner counts the
   * sizes separately. Once any option does, `inventory` above is kept equal to
   * the sum of them, so every "is this sellable" query can go on reading the
   * column alone.
   */
  sizes            Json?
  /**
   * What the dropdown is called on the product page — "Pot size", "Jar size".
   */
  sizeLabel        String?
  /**
   * Which gift guides the owner has deliberately put this product in, as guide
   * slugs from `lib/gifts.ts` ("tea-lover", "teacher"). Guides also match on
   * type, price and keywords, so an untagged product still lands somewhere
   * sensible; a tag only ever adds a guide.
   *
   * `GIFT_EXCLUDE_TAG` ("none") is reserved and means the opposite: keep this
   * product out of every guide, however well it matches. That is the one way
   * to say "this is not a gift" about something the derived rules would
   * otherwise pick up.
   */
  giftTags         String[]     @default([])
  /**
   * A bundle is an ordinary product sold as a set — one price, one SKU, one
   * line at checkout — so inventory, holds, refunds and Stripe all keep
   * working exactly as they do for anything else. The flag is merchandising:
   * it earns the product a badge and top billing on the gift pages.
   */
  bundle           Boolean      @default(false)
  /** What is in the bundle, one line per item, for the "what's inside" list. */
  bundleItems      String[]     @default([])
  active           Boolean      @default(true)
  featured         Boolean      @default(false)
  sortOrder        Int          @default(0)
  galleryImages    String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            OrderItem[]
  collections      Collection[] @relation("ProductCollections")
  reviews          Review[]
  stockAlerts      StockAlert[]
  careSheets       CareSheet[]
}

model Order {
  id                      String      @id @default(cuid())
  invoiceNumber           String      @unique
  stripeSessionId         String?     @unique
  paymentIntentId         String?     @unique
  stripeInvoiceId         String?
  status                  OrderStatus @default(PENDING)
  customerName            String
  email                   String
  phone                   String?
  address1                String
  address2                String?
  city                    String
  state                   String
  postalCode              String
  country                 String      @default("US")
  subtotalCents           Int
  shippingCents           Int         @default(0)
  taxCents                Int         @default(0)
  discountCents           Int         @default(0)
  totalCents              Int
  refundedCents           Int         @default(0)
  // Set once when a full refund returns stock, so repeated deliveries of the same
  // Stripe event cannot inflate inventory.
  inventoryRestoredAt     DateTime?
  shippingMethod          String?
  fulfillmentMethod       FulfillmentMethod @default(SHIP)
  giftMessage             String?
  pickupNote              String?
  trackingCarrier         String?
  trackingNumber          String?
  internalNotes           String?
  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?
  /**
   * When the "how did it settle in?" review invitation went out. Set once, and
   * checked before every send, so an order can only ever be asked once however
   * many times the follow-up runs.
   */
  reviewRequestSentAt     DateTime?
  fulfilledAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  items                   OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  /**
   * The size the customer chose, when the product is sold in more than one.
   */
  size      String?
  quantity  Int
  unitCents Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model CareSheet {
  id          String        @id @default(cuid())
  plantName   String
  slug        String        @unique
  guideType   CareGuideType @default(PLANT)
  category    String?
  difficulty  String?
  botanical   String?
  summary     String
  light       String        @default("")
  water       String        @default("")
  humidity    String        @default("")
  soil        String        @default("")
  feeding     String        @default("")
  temperature String        @default("")
  petSafety   String?
  tips        String
  symptoms    String?
  causes      String?
  treatment   String?
  prevention  String?
  checklist   String?
  imageUrl    String?
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  published   Boolean       @default(true)
  productId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ClassEvent {
  id                     String              @id @default(cuid())
  slug                   String?             @unique
  title                  String
  description            String
  startsAt               DateTime
  location               String
  format                 ClassFormat         @default(IN_PERSON)
  priceCents             Int
  capacity               Int
  durationMinutes        Int                 @default(90)
  whatToBring            String?
  registrationDeadline   DateTime?
  imageUrl               String?
  active                 Boolean             @default(true)
  onlineInstructions     String?
  telnyxRoomId           String?             @unique
  telnyxRecordingEnabled Boolean             @default(false)
  joinOpensMinutesBefore Int                 @default(30)
  joinClosesMinutesAfter Int                 @default(60)
  registrations          ClassRegistration[]
}

model ClassRegistration {
  id                      String             @id @default(cuid())
  classEventId            String
  stripeSessionId         String             @unique
  paymentIntentId         String?            @unique
  name                    String
  email                   String
  phone                   String?
  seats                   Int                @default(1)
  amountCents             Int
  status                  RegistrationStatus @default(PENDING)
  joinTokenHash           String?            @unique
  holdExpiresAt           DateTime?
  confirmationEmailSentAt DateTime?
  lastJoinedAt            DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  classEvent              ClassEvent         @relation(fields: [classEventId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  caption   String?
  linkUrl   String?
  linkLabel String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model AmazonPick {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  amazonUrl   String
  category    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  /**
   * Which signup form this address came from, as one of the keys in
   * `lib/newsletter-source.ts`. Anything the browser posts that is not on that
   * list is stored as "website", so the column stays a small set Tammy can
   * count rather than free text.
   */
  source         String?   @default("website")
  /**
   * The page the form was on, when knowing it helps — the product or care guide
   * slug behind a "product" or "care-guide" signup. A site path or nothing.
   */
  sourceDetail   String?
  active         Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  replies   EmailLog[]
}

/**
 * Every outbound email the app attempts, kept so the owner can answer "did she
 * ever get her receipt?" from the dashboard instead of from SendGrid's console.
 *
 * Failures are rows too, and that is the point of the table: a confirmation
 * that never left was previously visible only as a line in the server log.
 */
model EmailLog {
  id               String          @id @default(cuid())
  /**
   * Every recipient the send was addressed to. A list because the owner's new
   * order notice goes to the business inbox and her personal one together.
   */
  to               String[]        @default([])
  subject          String
  /** The exact body that was sent, so the page can show what she actually wrote. */
  html             String
  /**
   * The recipients and the message as plain text, built once when the row is
   * written so the sent-mail page can search in SQL and page through the result
   * properly. Searching the stored HTML in memory meant reading a fixed window
   * of recent rows — anything older than that window was unfindable, in a table
   * whose whole purpose is answering "did she ever get her receipt?".
   *
   * Owner-authored mail contributes only what Tammy typed, not the greeting,
   * signature and quoted message around it, or a search for "Hillside" would
   * match every email the shop has ever sent through its own sign-off.
   */
  searchText       String          @default("")
  kind             EmailKind       @default(OTHER)
  status           EmailStatus
  /** Why a failed send failed: not-configured, provider-error, network-error. */
  reason           String?
  /** SendGrid's x-message-id, for tracing a delivery in their dashboard. */
  providerId       String?
  /**
   * Set when this email is the owner's reply to a customer message, which is
   * what threads the reply under the message on the email page.
   */
  contactMessageId String?
  createdAt        DateTime        @default(now())
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([contactMessageId])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  tagline     String?
  description String?
  imageUrl    String?
  featured    Boolean   @default(true)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("ProductCollections")
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  authorName       String
  email            String?
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  ownerReply       String?
  /**
   * How many shoppers said this review helped them. The only ordering signal a
   * shop this size can honestly offer — there is no purchase history behind a
   * "most helpful" sort otherwise — and it is why that sort exists at all.
   */
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

model CartLead {
  id            String    @id @default(cuid())
  email         String    @unique
  itemsJson     String?
  subtotalCents Int       @default(0)
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  active            Boolean   @default(true)
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
