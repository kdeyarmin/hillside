{
  "name": "hillside-gardens",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-care.ts && tsx prisma/seed-categories.ts && tsx prisma/seed-collections.ts && tsx prisma/seed-category-content.ts",
    "db:seed:care": "tsx prisma/seed-care.ts",
    "db:seed:care:on-deploy": "tsx prisma/seed-care-on-deploy.ts && tsx prisma/seed-categories.ts && tsx prisma/seed-collections.ts && tsx prisma/seed-category-content.ts",
    "db:repair:images": "tsx prisma/repair-image-urls.ts",
    "db:repair:copy": "tsx prisma/repair-owner-copy.ts",
    "db:seed:collections": "tsx prisma/seed-collections.ts",
    "db:seed:categories": "tsx prisma/seed-categories.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "admin:create:on-deploy": "tsx prisma/create-admin.ts --optional",
    "images:brand": "node scripts/brand-image.mjs",
    "images:generate": "node scripts/generate-image.mjs",
    "images:measure": "node scripts/brand-image.mjs --measure public/images/catalog",
    "images:mockup": "node scripts/brand-mockup.mjs",
    "images:place": "node scripts/brand-place.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "images:variants": "node scripts/build-image-variants.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:weight": "node scripts/measure-page-weight.mjs",
    "db:seed:categories": "tsx prisma/seed-category-content.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "deepmerge-ts": "8.0.1"
  }
}
