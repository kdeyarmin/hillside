{
  "name": "hillside-gardens",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:brand-images": "node scripts/materialize-brand-images.mjs",
    "predev": "npm run prepare:brand-images",
    "dev": "next dev",
    "prebuild": "npm run prepare:brand-images",
    "build": "prisma generate && next build",
    "prestart": "npm run prepare:brand-images",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-care.ts",
    "db:seed:care": "tsx prisma/seed-care.ts",
    "db:seed:care:on-deploy": "tsx prisma/seed-care-on-deploy.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
